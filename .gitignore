# ============================================================================
# .gitignore - Ignorar todo excepto carpeta de modelos
# ============================================================================

# Carpetas de datos (archivos parquet pesados)
cbros_ct_datos_cliente_masked/
cbros_ct_gestiones_procesadas_masked/
cbros_ct_mejor_canal_masked/

# Archivos CSV grandes
*.csv
ids_prueba_ba_mejor_canal_contacto_oot.csv
submission*.csv
resultado*.csv

# NO ignorar la carpeta de modelos (descomenta si quieres incluirla)
!modelos/
!modelos/**

# Entorno virtual de Python
venv/
env/
.venv/
.env/

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# VS Code
.vscode/
*.code-workspace

# Archivos temporales
*.tmp
*.temp
temp_*.py
*.log

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Resultados y reportes (opcional)
resultados/
reportes/
